+export function sortedAvatarDecorationCategoryKeys(grouped: Record<string, unknown>): string[] {
+	return Object.keys(grouped).sort((a, b) => {
+		if (a === b) return 0;
+		if (a === '') return 1;
+		if (b === '') return -1;
+		return a.localeCompare(b, 'ja', { numeric: true });
+	});
