+/*
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+import { describe, expect, test } from 'vitest';
+import { buildFederationChartMetricQuery, federationChartMetrics } from './federation-blocked-host-query.js';
+
+describe(buildFederationChartMetricQuery, () => {
+	test.each(federationChartMetrics)('%s uses a single blocked-host array parameter', metric => {
+		const query = buildFederationChartMetricQuery(metric);
+
+		expect(query.match(/\$1/g)).toHaveLength(1);
+		expect(query).toContain('FROM unnest($1::text[]) AS rule');
+		expect(query).not.toContain(':...blocked');
+	});
+
+	test.each([
+		['sub', '"followeeHost"'],
+		['pub', '"followerHost"'],
+		['pubsub', '"followeeHost"'],
+		['subActive', '"followeeHost"'],
+		['pubActive', '"followerHost"'],
+	] as const)('%s selects candidates from %s', (metric, column) => {
+		expect(buildFederationChartMetricQuery(metric)).toContain(`SELECT DISTINCT f.${column} AS host`);
+	});
+
+	test('keeps wildcard rules on the ILIKE path', () => {
+		const query = buildFederationChartMetricQuery('pub');
+
+		expect(query).toContain("position('%' in rule) > 0 OR position('_' in rule) > 0 AS is_pattern");
+		expect(query).toContain("candidate.host ILIKE blocked.rule OR candidate.host ILIKE ('%.' || blocked.rule)");
+	});
+
+	test('keeps the metric-specific active and pubsub filters', () => {
+		expect(buildFederationChartMetricQuery('pubsub')).toContain('SELECT following."followerHost"');
+		expect(buildFederationChartMetricQuery('subActive')).toContain('instance."isNotResponding" = false');
+		expect(buildFederationChartMetricQuery('pubActive')).toContain('instance."isNotResponding" = false');
+		expect(buildFederationChartMetricQuery('sub')).not.toContain('instance."isNotResponding" = false');
+	});
+});
