+/*
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+export const federationChartMetrics = ['sub', 'pub', 'pubsub', 'subActive', 'pubActive'] as const;
+
+export type FederationChartMetric = typeof federationChartMetrics[number];
+
+const candidateColumns = {
+	sub: '"followeeHost"',
+	pub: '"followerHost"',
+	pubsub: '"followeeHost"',
+	subActive: '"followeeHost"',
+	pubActive: '"followerHost"',
+} as const satisfies Record<FederationChartMetric, string>;
+
+/**
+ * Builds the EXP-003 FederationChart query.
+ *
+ * Literal blocked-host rules use equality against generated DNS suffixes. Rules
+ * containing PostgreSQL ILIKE wildcards (`%` or `_`) stay on the ILIKE path so
+ * that the existing query's matching semantics are preserved.
+ */
+export function buildFederationChartMetricQuery(metric: FederationChartMetric): string {
+	const candidateColumn = candidateColumns[metric];
+	const common = `WITH candidates AS MATERIALIZED (
+	SELECT DISTINCT f.${candidateColumn} AS host
+	FROM following f
+	WHERE f.${candidateColumn} IS NOT NULL
+), blocked_rules AS MATERIALIZED (
+	SELECT lower(rule) AS rule,
+		position('%' in rule) > 0 OR position('_' in rule) > 0 AS is_pattern
+	FROM unnest($1::text[]) AS rule
+), candidate_suffixes AS MATERIALIZED (
+	SELECT c.host,
+		array_to_string(parts.value[position.value:array_length(parts.value, 1)], '.') AS suffix
+	FROM candidates c
+	CROSS JOIN LATERAL (SELECT string_to_array(lower(c.host), '.') AS value) parts
+	CROSS JOIN LATERAL generate_subscripts(parts.value, 1) AS position(value)
+), blocked_candidates AS MATERIALIZED (
+	SELECT suffix.host
+	FROM candidate_suffixes suffix
+	JOIN blocked_rules blocked ON NOT blocked.is_pattern AND blocked.rule = suffix.suffix
+	UNION
+	SELECT candidate.host
+	FROM candidates candidate
+	JOIN blocked_rules blocked ON blocked.is_pattern
+		AND (candidate.host ILIKE blocked.rule OR candidate.host ILIKE ('%.' || blocked.rule))
+)`;
+
+	if (metric === 'sub' || metric === 'pub') {
+		return `${common}
+SELECT count(*)
+FROM candidates candidate
+WHERE candidate.host NOT IN (SELECT host FROM blocked_candidates)
+	AND candidate.host NOT IN (
+		SELECT instance.host
+		FROM instance
+		WHERE instance."suspensionState" != 'none'
+	)`;
+	}
+
+	if (metric === 'pubsub') {
+		return `${common}
+SELECT count(*)
+FROM candidates candidate
+WHERE candidate.host NOT IN (SELECT host FROM blocked_candidates)
+	AND candidate.host NOT IN (
+		SELECT instance.host
+		FROM instance
+		WHERE instance."suspensionState" != 'none'
+	)
+	AND candidate.host IN (
+		SELECT following."followerHost"
+		FROM following
+		WHERE following."followerHost" IS NOT NULL
+	)`;
+	}
+
+	return `${common}
+SELECT count(instance.id)
+FROM instance
+WHERE instance.host IN (SELECT host FROM candidates)
+	AND instance.host NOT IN (SELECT host FROM blocked_candidates)
+	AND instance."suspensionState" = 'none'
+	AND instance."isNotResponding" = false`;
+}
