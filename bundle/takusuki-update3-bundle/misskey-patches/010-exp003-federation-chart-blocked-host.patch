+/*
+ * SPDX-FileCopyrightText: syuilo and misskey-project
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+import pg from 'pg';
+import { afterAll, beforeAll, describe, expect, test } from 'vitest';
+import { buildFederationChartMetricQuery, federationChartMetrics, type FederationChartMetric } from './federation-blocked-host-query.js';
+
+const databaseUrl = process.env.EXP003_DATABASE_URL;
+const describeWithDatabase = databaseUrl == null ? describe.skip : describe;
+
+const candidateColumns = {
+	sub: '"followeeHost"',
+	pub: '"followerHost"',
+	pubsub: '"followeeHost"',
+	subActive: '"followeeHost"',
+	pubActive: '"followerHost"',
+} as const satisfies Record<FederationChartMetric, string>;
+
+function buildOriginalQuery(metric: FederationChartMetric): string {
+	const column = candidateColumns[metric];
+
+	if (metric === 'sub' || metric === 'pub') {
+		return `SELECT count(DISTINCT following.${column})
+FROM following
+WHERE following.${column} IS NOT NULL
+	AND following.${column} NOT ILIKE ALL($1::text[])
+	AND following.${column} NOT IN (
+		SELECT instance.host FROM instance WHERE instance."suspensionState" != 'none'
+	)`;
+	}
+
+	if (metric === 'pubsub') {
+		return `SELECT count(DISTINCT following.${column})
+FROM following
+WHERE following.${column} IS NOT NULL
+	AND following.${column} NOT ILIKE ALL($1::text[])
+	AND following.${column} NOT IN (
+		SELECT instance.host FROM instance WHERE instance."suspensionState" != 'none'
+	)
+	AND following.${column} IN (
+		SELECT f."followerHost" FROM following f WHERE f."followerHost" IS NOT NULL
+	)`;
+	}
+
+	return `SELECT count(instance.id)
+FROM instance
+WHERE instance.host IN (
+		SELECT following.${column} FROM following WHERE following.${column} IS NOT NULL
+	)
+	AND instance.host NOT ILIKE ALL($1::text[])
+	AND instance."suspensionState" = 'none'
+	AND instance."isNotResponding" = false`;
+}
+
+function asOriginalRowQuery(metric: FederationChartMetric): string {
+	const query = buildOriginalQuery(metric).replace(/;$/, '');
+
+	if (metric === 'sub' || metric === 'pub' || metric === 'pubsub') {
+		return query.replace(/^SELECT count\(DISTINCT following\.("(?:followee|follower)Host")\)/, 'SELECT DISTINCT following.$1 AS key');
+	}
+
+	return query.replace(/^SELECT count\(instance\.id\)/, 'SELECT instance.id::text AS key');
+}
+
+function asRewrittenRowQuery(metric: FederationChartMetric): string {
+	const query = buildFederationChartMetricQuery(metric).replace(/\$1/g, '$2');
+
+	if (metric === 'sub' || metric === 'pub' || metric === 'pubsub') {
+		return query.replace('SELECT count(*)\nFROM candidates candidate', 'SELECT candidate.host AS key\nFROM candidates candidate');
+	}
+
+	return query.replace('SELECT count(instance.id)\nFROM instance', 'SELECT instance.id::text AS key\nFROM instance');
+}
+
+describeWithDatabase('EXP-003 PostgreSQL equivalence', () => {
+	const client = new pg.Client({ connectionString: databaseUrl });
+
+	beforeAll(async () => {
+		await client.connect();
+		await client.query(`
+CREATE TEMP TABLE following (
+	id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+	"followerHost" text,
+	"followeeHost" text
+);
+CREATE TEMP TABLE instance (
+	id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+	host text NOT NULL,
+	"suspensionState" text NOT NULL,
+	"isNotResponding" boolean NOT NULL
+);
+INSERT INTO following ("followerHost", "followeeHost") VALUES
+	('allowed.example', 'subscriber-only.example'),
+	('allowed.example', 'allowed.example'),
+	('blocked.example', 'sub.blocked.example'),
+	('sub.blocked.example', 'WILD2.example'),
+	('MiXeD.Blocked.Example', 'WILD22.example'),
+	('WILD1.example', 'percentZZ.example'),
+	('WILD12.example', 'underY.example'),
+	('percentABC.example', 'suspended.example'),
+	('underX.example', 'quiet.example'),
+	('suspended.example', 'blocked.example'),
+	('quiet.example', NULL),
+	(NULL, 'allowed.example');
+INSERT INTO instance (host, "suspensionState", "isNotResponding") VALUES
+	('allowed.example', 'none', false),
+	('subscriber-only.example', 'none', false),
+	('blocked.example', 'none', false),
+	('sub.blocked.example', 'none', false),
+	('MiXeD.Blocked.Example', 'none', false),
+	('WILD1.example', 'none', false),
+	('WILD12.example', 'none', false),
+	('WILD2.example', 'none', false),
+	('WILD22.example', 'none', false),
+	('percentABC.example', 'none', false),
+	('percentZZ.example', 'none', false),
+	('underX.example', 'none', false),
+	('underY.example', 'none', false),
+	('suspended.example', 'suspended', false),
+	('quiet.example', 'none', true);
+`);
+	});
+
+	afterAll(async () => {
+		await client.end();
+	});
+
+	test.each([
+		['empty', []],
+		['literal', ['BLOCKED.EXAMPLE']],
+		['wildcards', ['wild_.example', 'percent%.example', 'under_.example']],
+		['combined', ['BLOCKED.EXAMPLE', 'wild_.example', 'percent%.example', 'under_.example']],
+	] as const)('%s rules preserve all five metric counts', async (_name, blockedHosts) => {
+		const expandedRules = blockedHosts.flatMap(rule => [rule, `%.${rule}`]);
+
+		for (const metric of federationChartMetrics) {
+			const original = await client.query<{ count: string }>(buildOriginalQuery(metric), [expandedRules]);
+			const rewritten = await client.query<{ count: string }>(buildFederationChartMetricQuery(metric), [blockedHosts]);
+
+			expect(rewritten.rows[0].count, metric).toBe(original.rows[0].count);
+		}
+	});
+
+	test.each([
+		['empty', []],
+		['literal', ['BLOCKED.EXAMPLE']],
+		['wildcards', ['wild_.example', 'percent%.example', 'under_.example']],
+		['combined', ['BLOCKED.EXAMPLE', 'wild_.example', 'percent%.example', 'under_.example']],
+	] as const)('%s rules have zero bidirectional set difference', async (_name, blockedHosts) => {
+		const expandedRules = blockedHosts.flatMap(rule => [rule, `%.${rule}`]);
+
+		for (const metric of federationChartMetrics) {
+			const comparison = await client.query<{ original_minus_rewritten: string; rewritten_minus_original: string }>(`
+WITH original_rows AS MATERIALIZED (
+${asOriginalRowQuery(metric)}
+), rewritten_rows AS MATERIALIZED (
+${asRewrittenRowQuery(metric)}
+)
+SELECT
+	(SELECT count(*) FROM (SELECT * FROM original_rows EXCEPT SELECT * FROM rewritten_rows) difference)::text AS original_minus_rewritten,
+	(SELECT count(*) FROM (SELECT * FROM rewritten_rows EXCEPT SELECT * FROM original_rows) difference)::text AS rewritten_minus_original
+`, [expandedRules, blockedHosts]);
+
+			expect(comparison.rows[0], metric).toEqual({
+				original_minus_rewritten: '0',
+				rewritten_minus_original: '0',
+			});
+		}
+	});
+
+	test('combined fixture exercises suspended, not-responding, duplicate, NULL and wildcard cases', async () => {
+		const blockedHosts = ['BLOCKED.EXAMPLE', 'wild_.example', 'percent%.example', 'under_.example'];
+		const expected = { sub: '4', pub: '3', pubsub: '2', subActive: '3', pubActive: '2' };
+
+		for (const metric of federationChartMetrics) {
+			const result = await client.query<{ count: string }>(buildFederationChartMetricQuery(metric), [blockedHosts]);
+
+			expect(result.rows[0].count, metric).toBe(expected[metric]);
+		}
+	});
+});
